{
  "name": "cluenori-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "effect-tsgo patch",
    "watch": "node src/main.ts",
    "check": "tsc && oxfmt --check",
    "format": "oxfmt",
    "test": "TZ=Pacific/Chatham LANG=tr_TR.UTF-8 vitest run"
  },
  "dependencies": {
    "@bagatka/apns": "0.1.0",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.5",
    "@effect/vitest": "4.0.6",
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26"
  }
}
